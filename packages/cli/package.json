{
  "name": "@bullmq-monitor/cli",
  "version": "6.0.0",
  "description": "CLI for BullMQ Monitor - run a queue dashboard without writing any code",
  "keywords": [
    "bullmq",
    "bull",
    "cli",
    "queue",
    "dashboard",
    "monitor"
  ],
  "author": "Anton Kosiak (https://github.com/kosiakMD)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kosiakMD/bullmq-monitor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kosiakMD/bullmq-monitor/tree/main/packages/cli#readme",
  "bugs": "https://github.com/kosiakMD/bullmq-monitor/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bullmq-monitor": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/index.js",
    "clean": "rm -rf ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@bullmq-monitor/express": "^6.0.0",
    "@bullmq-monitor/root": "^6.0.0",
    "bull": "^4.16.0",
    "bullmq": "^5.0.0 || ^6.0.0",
    "commander": "^12.1.0",
    "express": "^5.1.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/bull": "^4.10.4",
    "@types/express": "^5.0.0",
    "typescript": "^5.9.0"
  }
}
