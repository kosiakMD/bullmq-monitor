{
  "name": "bullmq-monitor",
  "version": "6.1.0",
  "description": "BullMQ Monitor core: GraphQL API, queue adapters and the bundled dashboard UI",
  "keywords": [
    "bullmq",
    "bull",
    "queue",
    "dashboard",
    "monitor",
    "redis",
    "graphql"
  ],
  "author": "Anton Kosiak (https://github.com/kosiakMD)",
  "contributors": [
    "Ilya Strus <strax1990@gmail.com> (original bull-monitor author)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kosiakMD/bullmq-monitor.git",
    "directory": "packages/root"
  },
  "homepage": "https://github.com/kosiakMD/bullmq-monitor#readme",
  "bugs": "https://github.com/kosiakMD/bullmq-monitor/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy-ui",
    "clean": "rm -rf ./dist ./ui",
    "copy-ui": "node ./scripts/copy-ui.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.0",
    "jsonata": "^2.0.6",
    "lodash": "^4.17.21",
    "redis-info": "^3.1.0",
    "toad-scheduler": "^3.0.1"
  },
  "peerDependencies": {
    "bull": ">=4.0.0",
    "bullmq": ">=5.0.0",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "bull": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bull": "^4.10.4",
    "@types/lodash": "^4.17.0",
    "@types/redis-info": "^3.0.3",
    "bull": "^4.16.0",
    "bullmq": "^6.0.0",
    "ioredis": "^5.4.0",
    "typescript": "^5.9.0"
  },
  "gitHead": "cfba976965f1b0df5a8d0f6e5fe89b1ac490fa3b"
}
