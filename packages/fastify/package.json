{
  "name": "@bullmq-monitor/fastify",
  "version": "6.0.0",
  "description": "Fastify adapter for BullMQ Monitor - a dashboard for BullMQ and Bull queues",
  "keywords": [
    "bullmq",
    "bull",
    "fastify",
    "queue",
    "dashboard",
    "monitor"
  ],
  "author": "Anton Kosiak (https://github.com/kosiakMD)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kosiakMD/bullmq-monitor.git",
    "directory": "packages/fastify"
  },
  "homepage": "https://github.com/kosiakMD/bullmq-monitor/tree/main/packages/fastify#readme",
  "bugs": "https://github.com/kosiakMD/bullmq-monitor/issues",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
