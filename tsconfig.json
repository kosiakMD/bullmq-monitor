{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "declaration": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false
  },
  "include": ["packages/*/src", "examples/*/src", "examples/*/*.ts"],
  "exclude": ["node_modules", "dist", "packages/ui"]
}
